generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ENUMS
 */
enum Role {
  STUDENT
  PROFESSOR
  SECRETARIAT
}

enum ThesisStatus {
  UNDER_ASSIGNMENT
  ACTIVE
  UNDER_EXAMINATION
  COMPLETED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ExamMode {
  ONSITE
  ONLINE
}

model Student {
  id              Int     @id @default(autoincrement())
  am              String  @unique
  address         String?
  cellPhoneNumber String?
  phoneNumber     String?

  userId          Int     @unique
  user User @relation(fields: [userId], references: [id])
}

model Professor {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  // TODO: Add theses etc here
  topics Topic[]
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  role      Role
  firstName String
  lastName  String
  username  String @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student?
  professor Professor?
}

model Topic {
  id                     Int        @id @default(autoincrement())
  title                  String     @unique
  description            String     @db.Text
  extendedDescriptionPdf Bytes?
  professor              Professor? @relation(fields: [professorId], references: [id])
  professorId            Int?
}
