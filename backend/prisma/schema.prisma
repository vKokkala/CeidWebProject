// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ENUMS
 */
enum Role {
  STUDENT
  PROFESSOR
  SECRETARIAT
}

enum ThesisStatus {
  UNDER_ASSIGNMENT
  ACTIVE
  UNDER_EXAMINATION
  COMPLETED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ExamMode {
  ONSITE
  ONLINE
}

enum CommitteeRole {
  SUPERVISOR
  MEMBER
}

model Student {
  id              Int     @id @default(autoincrement())
  am              String  @unique
  address         String?
  cellPhoneNumber String?
  phoneNumber     String?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  // CHECK
  // thesis   Thesis? @relation(fields: [thesisId], references: [id])
  // thesisId Int?

  thesis Thesis?
}

model Professor {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  topics                          Topic[]
  theses                          Thesis[]
  grades                          Grade[]
  supervisedTheses                Thesis[]                         @relation("SupervisedTheses")
  committeeMembers                CommitteeMember[]
  committeeInvitations            CommitteeInvitation[]
  notes                           ThesisNote[]
  // thesisPresentationAnnouncements ThesisPresentationAnnouncement[]
}

model Secretariat {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  role      Role
  firstName String
  lastName  String
  username  String @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     Student?
  professor   Professor?
  secretariat Secretariat?
}

model Topic {
  id          Int    @id @default(autoincrement())
  title       String @unique
  description String @db.Text

  pdfFile     Bytes?
  pdfFileName String?
  pdfMimeType String?
  pdfSize     Int?

  professorId Int?
  professor   Professor? @relation(fields: [professorId], references: [id])

  isAssigned Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  thesis Thesis?
}

model AssignmentCancellation {
  id Int @id @default(autoincrement())

  generalCommitteeGatheringNumber Int?
  generalCommitteeGatheringYear   Int?

  reason String
}

model CommitteeInvitation {
  id               Int              @id @default(autoincrement())
  Role             CommitteeRole    @default(MEMBER)
  invitationStatus InvitationStatus @default(PENDING)

  thesisId Int
  thesis   Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  professorId Int
  professor   Professor @relation(fields: [professorId], references: [id])

  createdAt DateTime @default(now())
  repliedAt DateTime @updatedAt
}

model Grade {
  id Int @id @default(autoincrement())

  criterion1Score Decimal? @db.Decimal(4, 2)
  criterion2Score Decimal? @db.Decimal(4, 2)
  criterion3Score Decimal? @db.Decimal(4, 2)
  criterion4Score Decimal? @db.Decimal(4, 2)
  criterion5Score Decimal? @db.Decimal(4, 2)

  totalGrade Decimal @db.Decimal(4, 2)
  comments   String? @db.Text

  thesisId Int
  thesis   Thesis? @relation(fields: [thesisId], references: [id])

  professorId Int
  professor   Professor? @relation(fields: [professorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Thesis {
  id Int @id @default(autoincrement())

  status ThesisStatus @default(UNDER_ASSIGNMENT)

  // dATES 
  // assignmentFinalisedAt  DateTime?
  officialAssignmentDate DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?

  examinationDate  DateTime?
  examinationMode  ExamMode?
  examinationPlace String? // link or ai8ousa

  topicId Int?   @unique
  topic   Topic? @relation(fields: [topicId], references: [id])

  studentId Int     @unique
  student   Student @relation(fields: [studentId], references: [id])

  professorId Int?
  professor   Professor? @relation(fields: [professorId], references: [id])

  supervisorId Int
  supervisor   Professor @relation("SupervisedTheses", fields: [supervisorId], references: [id])

  committeeMembers     CommitteeMember[]
  committeeInvitations CommitteeInvitation[]
  statusChanges        ThesisStatusChange[]
  notes                ThesisNote[]
  grades               Grade[]

  isGradingEnabled Boolean @default(false)

  relevantLinks  String[]
  thesisDocument Bytes?

  nemertisLink String?

  finalGrade                      Decimal?                         @db.Decimal(4, 2)
  thesisPresentationAnnouncements ThesisPresentationAnnouncement[]
}

model ThesisStatusChange {
  id         Int           @id @default(autoincrement())
  fromStatus ThesisStatus?
  toStatus   ThesisStatus
  changedAt  DateTime      @default(now())

  // TODO: what key do I need here?
  changedBy String
  notes     String? @db.Text

  thesisId Int
  thesis   Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)
}

model ThesisNote {
  id   Int    @id @default(autoincrement())
  note String @db.VarChar(300)

  thesisId Int
  thesis   Thesis? @relation(fields: [thesisId], references: [id])

  professorId Int
  professor   Professor @relation(fields: [professorId], references: [id])
}

model CommitteeMember {
  id         Int           @id @default(autoincrement())
  role       CommitteeRole
  acceptedAt DateTime      @default(now())

  thesisId Int
  thesis   Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  professorId Int
  professor   Professor @relation(fields: [professorId], references: [id])
}

model ThesisPresentationAnnouncement {
  id Int @id @default(autoincrement())

  thesisId Int
  thesis   Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  createdAt        DateTime  @default(now())
}
